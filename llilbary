-- ========================================================
-- ELITE HUB - Modern UI Library with Integrated AI Assistant
-- Sağ Üst AI Butonlu ve Otomatik Çalıştırma Destekli Sürüm
-- ========================================================

local EliteHub = {}
EliteHub.__index = EliteHub

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

function EliteHub:CreateWindow(Settings)
    Settings = Settings or {}
    local WindowName = Settings.Name or "ELITE HUB"
    
    -- Eski GUI Temizliği
    if CoreGui:FindFirstChild("EliteHubLibrary") then
        CoreGui.EliteHubLibrary:Destroy()
    end

    -- ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "EliteHubLibrary"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false

    -- Ana Gövde Panel (480x300)
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Parent = ScreenGui
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.Size = UDim2.new(0, 480, 0, 300)
    Main.BackgroundColor3 = Color3.fromRGB(12, 9, 18)
    Main.BackgroundTransparency = 0.25
    Main.ClipsDescendants = false

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 20)
    MainCorner.Parent = Main

    -- Dokunmayı Arkaya Geçirmeyen Modal Siper
    local ModalBlocker = Instance.new("TextButton")
    ModalBlocker.Name = "ModalBlocker"
    ModalBlocker.Parent = Main
    ModalBlocker.Size = UDim2.new(1, 0, 1, 0)
    ModalBlocker.BackgroundTransparency = 1
    ModalBlocker.Text = ""
    ModalBlocker.Modal = true

    -- Arka Plan Gölgesi
    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Parent = Main
    Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    Shadow.Position = UDim2.new(0.5, 0, 0.5, 4)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://6014261993"
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.4
    Shadow.ZIndex = 0

    -- UI Stroke (Çerçeve Parlaması)
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Parent = Main
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    MainStroke.Thickness = 1.4

    local StrokeGradient = Instance.new("UIGradient")
    StrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 85, 235)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(35, 18, 55)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 50, 190))
    })
    StrokeGradient.Rotation = 45
    StrokeGradient.Parent = MainStroke

    -- İçerik Kapsayıcısı
    local Content = Instance.new("Frame")
    Content.Name = "Content"
    Content.Parent = Main
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.BackgroundTransparency = 1
    Content.ClipsDescendants = true
    Content.ZIndex = 2

    local ContentCorner = Instance.new("UICorner")
    ContentCorner.CornerRadius = UDim.new(0, 20)
    ContentCorner.Parent = Content

    -- Header (Üst Alan)
    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Parent = Content
    Header.Size = UDim2.new(1, 0, 0, 54)
    Header.BackgroundTransparency = 1

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Parent = Header
    Title.Position = UDim2.new(0, 22, 0.5, -13)
    Title.Size = UDim2.new(0, 180, 0, 26)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBlack
    Title.Text = string.upper(WindowName)
    Title.TextColor3 = Color3.fromRGB(245, 240, 255)
    Title.TextSize = 19
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local TitleGradient = Instance.new("UIGradient")
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(175, 130, 235))
    })
    TitleGradient.Parent = Title

    -- Kapatma (X) Butonu
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Name = "CloseBtn"
    CloseBtn.Parent = Header
    CloseBtn.Position = UDim2.new(1, -42, 0.5, -13)
    CloseBtn.Size = UDim2.new(0, 26, 0, 26)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Font = Enum.Font.ArialBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(190, 170, 220)
    CloseBtn.TextSize = 15
    CloseBtn.AutoButtonColor = false

    CloseBtn.MouseEnter:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 70, 90)}):Play()
    end)
    CloseBtn.MouseLeave:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(190, 170, 220)}):Play()
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        TweenService:Create(Shadow, TweenInfo.new(0.15), {ImageTransparency = 1}):Play()
        closeTween:Play()
        closeTween.Completed:Wait()
        ScreenGui:Destroy()
    end)

    -- Sağ Üst AI Açma Butonu
    local AIToggleBtn = Instance.new("TextButton")
    AIToggleBtn.Name = "AIToggleBtn"
    AIToggleBtn.Parent = Header
    AIToggleBtn.Position = UDim2.new(1, -76, 0.5, -13)
    AIToggleBtn.Size = UDim2.new(0, 28, 0, 26)
    AIToggleBtn.BackgroundColor3 = Color3.fromRGB(48, 26, 75)
    AIToggleBtn.BackgroundTransparency = 0.3
    AIToggleBtn.Font = Enum.Font.GothamBold
    AIToggleBtn.Text = "AI"
    AIToggleBtn.TextColor3 = Color3.fromRGB(210, 185, 255)
    AIToggleBtn.TextSize = 12
    AIToggleBtn.AutoButtonColor = false

    local AIBtnCorner = Instance.new("UICorner")
    AIBtnCorner.CornerRadius = UDim.new(0, 6)
    AIBtnCorner.Parent = AIToggleBtn

    local AIBtnStroke = Instance.new("UIStroke")
    AIBtnStroke.Parent = AIToggleBtn
    AIBtnStroke.Color = Color3.fromRGB(160, 85, 235)
    AIBtnStroke.Thickness = 1
    AIBtnStroke.Transparency = 0.5

    AIToggleBtn.MouseEnter:Connect(function()
        TweenService:Create(AIToggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(160, 85, 235), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)
    AIToggleBtn.MouseLeave:Connect(function()
        TweenService:Create(AIToggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(48, 26, 75), TextColor3 = Color3.fromRGB(210, 185, 255)}):Play()
    end)

    -- Sürükleme Mantığı (Smooth Lerp + Modal)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local targetPos = Main.Position

    Header.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            dragInput = input
            dragStart = input.Position
            startPos = Main.Position
            targetPos = Main.Position

            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    dragInput = nil
                    conn:Disconnect()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging or (Main.Position ~= targetPos) then
            Main.Position = Main.Position:Lerp(targetPos, 0.25)
        end
    end)

    -- Normal İçerik Kapsayıcısı (ScrollingFrame)
    local Container = Instance.new("ScrollingFrame")
    Container.Name = "Container"
    Container.Parent = Content
    Container.BackgroundTransparency = 1
    Container.Position = UDim2.new(0, 22, 0, 56)
    Container.Size = UDim2.new(1, -44, 0, 185)
    Container.ScrollBarThickness = 2
    Container.ScrollBarImageColor3 = Color3.fromRGB(150, 90, 220)
    Container.BorderSizePixel = 0

    local UIGrid = Instance.new("UIGridLayout")
    UIGrid.Parent = Container
    UIGrid.CellSize = UDim2.new(0.48, 0, 0, 68)
    UIGrid.CellPadding = UDim2.new(0.04, 0, 0, 12)
    UIGrid.HorizontalAlignment = Enum.HorizontalAlignment.Center

    UIGrid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Container.CanvasSize = UDim2.new(0, 0, 0, UIGrid.AbsoluteContentSize.Y + 10)
    end)

    -- --- AYRI AI SOHBET MENÜSÜ (PENCERE İÇİNDE AÇILAN PANEL) ---
    local AIChatFrame = Instance.new("Frame")
    AIChatFrame.Name = "AIChatFrame"
    AIChatFrame.Parent = Content
    AIChatFrame.Position = UDim2.new(0, 22, 0, 56)
    AIChatFrame.Size = UDim2.new(1, -44, 0, 185)
    AIChatFrame.BackgroundColor3 = Color3.fromRGB(18, 12, 28)
    AIChatFrame.BackgroundTransparency = 0.1
    AIChatFrame.Visible = false
    AIChatFrame.ZIndex = 5

    local AIChatCorner = Instance.new("UICorner")
    AIChatCorner.CornerRadius = UDim.new(0, 12)
    AIChatCorner.Parent = AIChatFrame

    local AIChatStroke = Instance.new("UIStroke")
    AIChatStroke.Parent = AIChatFrame
    AIChatStroke.Color = Color3.fromRGB(160, 85, 235)
    AIChatStroke.Thickness = 1.2
    AIChatStroke.Transparency = 0.3

    -- Sohbet Geçmişi Kaydırma Alanı
    local ChatScroll = Instance.new("ScrollingFrame")
    ChatScroll.Name = "ChatScroll"
    ChatScroll.Parent = AIChatFrame
    ChatScroll.Position = UDim2.new(0, 8, 0, 8)
    ChatScroll.Size = UDim2.new(1, -16, 1, -52)
    ChatScroll.BackgroundTransparency = 1
    ChatScroll.ScrollBarThickness = 2
    ChatScroll.ScrollBarImageColor3 = Color3.fromRGB(160, 85, 235)
    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    ChatScroll.BorderSizePixel = 0

    local ChatList = Instance.new("UIListLayout")
    ChatList.Parent = ChatScroll
    ChatList.SortOrder = Enum.SortOrder.LayoutOrder
    ChatList.Padding = UDim.new(0, 6)

    ChatList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatList.AbsoluteContentSize.Y + 10)
        ChatScroll.CanvasPosition = Vector2.new(0, ChatList.AbsoluteContentSize.Y)
    end)

    local function AddMessage(sender, text, isUser)
        local msgContainer = Instance.new("Frame")
        msgContainer.Parent = ChatScroll
        msgContainer.Size = UDim2.new(1, 0, 0, 0)
        msgContainer.AutomaticSize = Enum.AutomaticSize.Y
        msgContainer.BackgroundTransparency = 1

        local bubble = Instance.new("TextLabel")
        bubble.Parent = msgContainer
        bubble.Size = UDim2.new(0.92, 0, 0, 0)
        bubble.AutomaticSize = Enum.AutomaticSize.Y
        bubble.Position = isUser and UDim2.new(0.08, 0, 0, 0) or UDim2.new(0, 0, 0, 0)
        bubble.BackgroundColor3 = isUser and Color3.fromRGB(48, 26, 75) or Color3.fromRGB(12, 8, 18)
        bubble.BackgroundTransparency = 0.2
        bubble.Font = Enum.Font.Gotham
        bubble.Text = "<b>" .. sender .. ":</b>\n" .. text
        bubble.TextColor3 = Color3.fromRGB(235, 225, 255)
        bubble.TextSize = 11
        bubble.TextWrapped = true
        bubble.RichText = true
        bubble.TextXAlignment = Enum.TextXAlignment.Left

        local bubbleCorner = Instance.new("UICorner")
        bubbleCorner.CornerRadius = UDim.new(0, 6)
        bubbleCorner.Parent = bubble

        local padding = Instance.new("UIPadding")
        padding.Parent = bubble
        padding.PaddingTop = UDim.new(0, 6)
        padding.PaddingBottom = UDim.new(0, 6)
        padding.PaddingLeft = UDim.new(0, 8)
        padding.PaddingRight = UDim.new(0, 8)
    end

    AddMessage("Elite AI", "Selam! Yapay zeka aktif. Kod yanıtları otomatik çalıştırılır.", false)

    -- Alt Mesaj Giriş Alanı
    local AIInputBox = Instance.new("TextBox")
AIInputBox.Name = "AIInputBox"
    AIInputBox.Parent = AIChatFrame
    AIInputBox.Position = UDim2.new(0, 8, 1, -38)
    AIInputBox.Size = UDim2.new(0.74, -4, 0, 30)
    AIInputBox.BackgroundColor3 = Color3.fromRGB(12, 8, 18)
    AIInputBox.BackgroundTransparency = 0.5
    AIInputBox.Font = Enum.Font.GothamMedium
    AIInputBox.PlaceholderText = "Yapay zekaya sor..."
    AIInputBox.Text = ""
    AIInputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    AIInputBox.TextSize = 11
    AIInputBox.ClearTextOnFocus = false

    local AIInputCorner = Instance.new("UICorner")
    AIInputCorner.CornerRadius = UDim.new(0, 6)
    AIInputCorner.Parent = AIInputBox

    local AISendBtn = Instance.new("TextButton")
    AISendBtn.Name = "AISendBtn"
    AISendBtn.Parent = AIChatFrame
    AISendBtn.Position = UDim2.new(0.76, 0, 1, -38)
    AISendBtn.Size = UDim2.new(0.24, -4, 0, 30)
    AISendBtn.BackgroundColor3 = Color3.fromRGB(160, 85, 235)
    AISendBtn.BackgroundTransparency = 0.2
    AISendBtn.Font = Enum.Font.GothamBold
    AISendBtn.Text = "Gönder"
    AISendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    AISendBtn.TextSize = 11
    AISendBtn.AutoButtonColor = false

    local AISendCorner = Instance.new("UICorner")
    AISendCorner.CornerRadius = UDim.new(0, 6)
    AISendCorner.Parent = AISendBtn

    -- AI Menüsünü Açıp Kapatma Mantığı
    local aiOpen = false
    AIToggleBtn.MouseButton1Click:Connect(function()
        aiOpen = not aiOpen
        AIChatFrame.Visible = aiOpen
        Container.Visible = not aiOpen
        AIToggleBtn.TextColor3 = aiOpen and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(210, 185, 255)
    end)

    -- Mesaj Gönderme ve API İstek Mantığı
    AISendBtn.MouseButton1Click:Connect(function()
        local userMessage = AIInputBox.Text
        if userMessage == "" then return end

        AddMessage("Sen", userMessage, true)
        AIInputBox.Text = ""
        AISendBtn.Active = false

        task.spawn(function()
            local requestBody = {
                language = "Luau",
                task = "write",
                prompt = "Eğer bir kod yazman gerekiyorsa, kesinlikle başı '[( ' ve sonu ' )]' olacak şekilde bu işaretlerin arasına koy. Normal metinlerde kullanma. İstek: " .. userMessage,
                history = {}
            }

            local success, response = pcall(function()
                return HttpService:RequestAsync({
                    Url = "https://8328-iaegwjno6hih212t36m6p-3442aba1.us3.manus.computer/api/chat",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode(requestBody),
                })
            end)

            if success and response and response.Success then
                local decodedSuccess, decodedBody = pcall(function()
                    return HttpService:JSONDecode(response.Body)
                end)
                
                if decodedSuccess and decodedBody and decodedBody.answer then
                    local aiReply = tostring(decodedBody.answer)
                    AddMessage("Elite AI", aiReply, false)

                    -- [( ve )] arasındaki kodu otomatik çalıştır
                    local extractedCode = aiReply:match("%[%((.-)%)]")
                    if extractedCode then
                        local func, err = loadstring(extractedCode)
                        if func then
                            local runSuccess, runErr = pcall(func)
                            if runSuccess then
                                AddMessage("Sistem", "✔ Kod başarıyla çalıştırıldı!", false)
                            else
                                AddMessage("Sistem", "❌ Çalıştırma Hatası: " .. tostring(runErr), false)
                            end
                        else
                            AddMessage("Sistem", "❌ Syntax Hatası: " .. tostring(err), false)
                        end
                    end
                else
                    AddMessage("Elite AI", "Hata: Yanıt şemasında 'answer' bulunamadı.", false)
                end
            else
                AddMessage("Elite AI", "Bağlantı hatası oluştu!", false)
            end
            AISendBtn.Active = true
        end)
    end)
    --------------------------------------------------------

    -- Profil Alt Şeridi
    local UserFooter = Instance.new("Frame")
    UserFooter.Name = "UserFooter"
    UserFooter.Parent = Content
    UserFooter.Position = UDim2.new(0, 22, 1, -40)
    UserFooter.Size = UDim2.new(1, -44, 0, 32)
    UserFooter.BackgroundTransparency = 1

    local UserAvatar = Instance.new("ImageLabel")
    UserAvatar.Name = "UserAvatar"
    UserAvatar.Parent = UserFooter
    UserAvatar.Position = UDim2.new(0, 0, 0.5, -13)
    UserAvatar.Size = UDim2.new(0, 26, 0, 26)
    UserAvatar.BackgroundTransparency = 1
    UserAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"

    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = UserAvatar

    local UserName = Instance.new("TextLabel")
    UserName.Name = "UserName"
    UserName.Parent = UserFooter
    UserName.Position = UDim2.new(0, 34, 0, 0)
    UserName.Size = UDim2.new(0, 220, 1, 0)
    UserName.BackgroundTransparency = 1
    UserName.Font = Enum.Font.GothamMedium
    UserName.Text = LocalPlayer.Name
    UserName.TextColor3 = Color3.fromRGB(210, 195, 235)
    UserName.TextSize = 13
    UserName.TextXAlignment = Enum.TextXAlignment.Left

    local StatusText = Instance.new("TextLabel")
    StatusText.Name = "StatusText"
    StatusText.Parent = UserFooter
    StatusText.Position = UDim2.new(1, -100, 0, 0)
    StatusText.Size = UDim2.new(0, 100, 1, 0)
    StatusText.BackgroundTransparency = 1
    StatusText.Font = Enum.Font.GothamBold
    StatusText.Text = "● ONLINE"
    StatusText.TextColor3 = Color3.fromRGB(100, 210, 150)
    StatusText.TextSize = 11
    StatusText.TextXAlignment = Enum.TextXAlignment.Right

    -- Açılış Animasyonu
    Main.Size = UDim2.new(0, 0, 0, 0)
    Shadow.ImageTransparency = 1

    TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 480, 0, 300)
    }):Play()

    TweenService:Create(Shadow, TweenInfo.new(0.35), {
        ImageTransparency = 0.4
    }):Play()

    -- Tab Yapısı Nesnesi
    local WindowElements = {}

    function WindowElements:CreateButton(ButtonSettings)
        ButtonSettings = ButtonSettings or {}
        local BtnName = ButtonSettings.Name or "Button"
        local Callback = ButtonSettings.Callback or function() end

        local btn = Instance.new("TextButton")
        btn.Name = BtnName
        btn.Parent = Container
        btn.BackgroundColor3 = Color3.fromRGB(22, 15, 32)
        btn.BackgroundTransparency = 0.3
        btn.AutoButtonColor = false
        btn.Font = Enum.Font.GothamMedium
        btn.Text = BtnName
        btn.TextColor3 = Color3.fromRGB(220, 210, 235)
        btn.TextSize = 14

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 14)
        btnCorner.Parent = btn

        local btnStroke = Instance.new("UIStroke")
        btnStroke.Parent = btn
        btnStroke.Color = Color3.fromRGB(65, 38, 98)
        btnStroke.Thickness = 1.2
        btnStroke.Transparency = 0.5

        -- Hover & Click Animasyonu
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(48, 26, 75),
                BackgroundTransparency = 0.1,
                TextColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), {
                Color = Color3.fromRGB(160, 85, 235),
                Transparency = 0
            }):Play()
        end)

        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(22, 15, 32),
                BackgroundTransparency = 0.3,
                TextColor3 = Color3.fromRGB(220, 210, 235)
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), {
                Color = Color3.fromRGB(65, 38, 98),
                Transparency = 0.5
            }):Play()
        end)

        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.06), {Size = UDim2.new(0.45, 0, 0, 63)}):Play()
        end)

        btn.MouseButton1Up:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0.48, 0, 0, 68)}):Play()
            pcall(Callback)
        end)

        return btn
    end

    return WindowElements
end

return EliteHub
