    -- DİNAMİK BUTON GRUBU (Çizimine göre 1, 2 veya 3 buton desteği)
    function WindowElements:CreateButtonGroup(ButtonsData)
        ButtonsData = ButtonsData or {}
        local count = #ButtonsData
        if count == 0 then return end

        local rowFrame = Instance.new("Frame")
        rowFrame.Parent = Container
        rowFrame.BackgroundTransparency = 1

        local function applyButtonStyles(btn)
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = btn

            local stroke = Instance.new("UIStroke")
            stroke.Parent = btn
            stroke.Color = Color3.fromRGB(60, 30, 95)
            stroke.Thickness = 1.4
            stroke.Transparency = 0.3

            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(36, 20, 60), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(150, 70, 220), Transparency = 0}):Play()
            end)

            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(16, 11, 26), TextColor3 = Color3.fromRGB(220, 210, 240)}):Play()
                TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(60, 30, 95), Transparency = 0.3}):Play()
            end)
        end

        if count == 1 then
            -- 1 Buton: Çizimdeki 1 numaralı yapı (Tam boy dev buton)
            rowFrame.Size = UDim2.new(1, 0, 0, 56)
            local btn = Instance.new("TextButton")
            btn.Parent = rowFrame
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.AutoButtonColor = false
            btn.Font = Enum.Font.GothamBold
            btn.Text = ButtonsData[1].Name or "Buton"
            btn.TextColor3 = Color3.fromRGB(220, 210, 240)
            btn.TextSize = 14
            btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
            btn.BackgroundTransparency = 0.15

            applyButtonStyles(btn)
            btn.MouseButton1Click:Connect(function()
                pcall(ButtonsData[1].Callback or function() end)
            end)

        elseif count == 2 then
            -- 2 Buton: Çizimdeki 2 numaralı yapı (Yana yana 2 büyük buton)
            rowFrame.Size = UDim2.new(1, 0, 0, 56)
            for i, data in ipairs(ButtonsData) do
                local btn = Instance.new("TextButton")
                btn.Parent = rowFrame
                btn.Size = UDim2.new(0.48, 0, 1, 0)
                btn.Position = UDim2.new((i - 1) * 0.52, 0, 0, 0)
                btn.AutoButtonColor = false
                btn.Font = Enum.Font.GothamBold
                btn.Text = data.Name or "Buton"
                btn.TextColor3 = Color3.fromRGB(220, 210, 240)
                btn.TextSize = 14
                btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
                btn.BackgroundTransparency = 0.15

                applyButtonStyles(btn)
                btn.MouseButton1Click:Connect(function()
                    pcall(data.Callback or function() end)
                end)
            end

        elseif count >= 3 then
            -- 3 Buton: Çizimdeki 3 numaralı yapı (Üstte 2 yan yana, altta 1 tam boy dev buton)
            rowFrame.Size = UDim2.new(1, 0, 0, 122) -- İki katlı yükseklik

            -- Üstteki 2 buton
            for i = 1, 2 do
                local data = ButtonsData[i]
                if data then
                    local btn = Instance.new("TextButton")
                    btn.Parent = rowFrame
                    btn.Size = UDim2.new(0.48, 0, 0, 56)
                    btn.Position = UDim2.new((i - 1) * 0.52, 0, 0, 0)
                    btn.AutoButtonColor = false
                    btn.Font = Enum.Font.GothamBold
                    btn.Text = data.Name or "Buton"
                    btn.TextColor3 = Color3.fromRGB(220, 210, 240)
                    btn.TextSize = 14
                    btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
                    btn.BackgroundTransparency = 0.15

                    applyButtonStyles(btn)
                    btn.MouseButton1Click:Connect(function()
                        pcall(data.Callback or function() end)
                    end)
                end
            end

            -- Alttaki 1 tam boy dev buton
            local data3 = ButtonsData[3]
            if data3 then
                local btn3 = Instance.new("TextButton")
                btn3.Parent = rowFrame
                btn3.Size = UDim2.new(1, 0, 0, 56)
                btn3.Position = UDim2.new(0, 0, 0, 66)
                btn3.AutoButtonColor = false
                btn3.Font = Enum.Font.GothamBold
                btn3.Text = data3.Name or "Buton"
                btn3.TextColor3 = Color3.fromRGB(220, 210, 240)
                btn3.TextSize = 14
                btn3.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
                btn3.BackgroundTransparency = 0.15

                applyButtonStyles(btn3)
                btn3.MouseButton1Click:Connect(function()
                    pcall(data3.Callback or function() end)
                end)
            end
        end

        return rowFrame
    end

