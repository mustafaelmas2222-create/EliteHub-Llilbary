-- ========================================================
-- ELITE HUB - MODERN UI + AI INTEGRATION
-- Rayfield Tarzı + Özel AI Penceresi
-- ========================================================

local EliteHub = {}
EliteHub.__index = EliteHub

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

-- Renk Paleti (Zarif Mor/Mavi)
local Colors = {
    BG = Color3.fromRGB(12, 9, 18),
    StrokeStart = Color3.fromRGB(160, 85, 235),
    StrokeMid = Color3.fromRGB(35, 18, 55),
    StrokeEnd = Color3.fromRGB(120, 50, 190),
    TextMain = Color3.fromRGB(245, 240, 255),
    TextSub = Color3.fromRGB(175, 130, 235),
    BtnBg = Color3.fromRGB(22, 15, 32),
    BtnHover = Color3.fromRGB(48, 26, 75),
    AIBg = Color3.fromRGB(15, 12, 22), -- AI için biraz daha koyu
    AIStroke = Color3.fromRGB(0, 200, 255), -- AI için özel mavi vurgu
}

function EliteHub:CreateWindow(Settings)
    Settings = Settings or {}
    local WindowName = Settings.Name or "ELITE HUB"
    
    -- Eski GUI Temizliği
    if CoreGui:FindFirstChild("EliteHubLibrary") then
        CoreGui.EliteHubLibrary:Destroy()
    end

    -- ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "EliteHubLibrary"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- ==========================================
    -- ANA MENÜ (MAIN WINDOW)
    -- ==========================================
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Parent = ScreenGui
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.Size = UDim2.new(0, 480, 0, 300)
    Main.BackgroundColor3 = Colors.BG
    Main.BackgroundTransparency = 0.25
    Main.ClipsDescendants = false
    Main.ZIndex = 10

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 20)
    MainCorner.Parent = Main

    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Parent = Main
    Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    Shadow.Position = UDim2.new(0.5, 0, 0.5, 4)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://6014261993"
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.4
    Shadow.ZIndex = 0

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Parent = Main
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    MainStroke.Thickness = 1.4

    local StrokeGradient = Instance.new("UIGradient")
    StrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Colors.StrokeStart),
        ColorSequenceKeypoint.new(0.5, Colors.StrokeMid),
        ColorSequenceKeypoint.new(1, Colors.StrokeEnd)
    })
    StrokeGradient.Rotation = 45
    StrokeGradient.Parent = MainStroke

    local Content = Instance.new("Frame")
    Content.Name = "Content"
    Content.Parent = Main
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.BackgroundTransparency = 1
    Content.ClipsDescendants = true
    Content.ZIndex = 2

    local ContentCorner = Instance.new("UICorner")
    ContentCorner.CornerRadius = UDim.new(0, 20)
    ContentCorner.Parent = Content

    -- Header
    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Parent = Content
    Header.Size = UDim2.new(1, 0, 0, 54)
    Header.BackgroundTransparency = 1

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Parent = Header
    Title.Position = UDim2.new(0, 22, 0.5, -13)
    Title.Size = UDim2.new(0, 200, 0, 26)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBlack
    Title.Text = string.upper(WindowName)
    Title.TextColor3 = Colors.TextMain
    Title.TextSize = 19
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local TitleGradient = Instance.new("UIGradient")
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Colors.TextSub)
    })
    TitleGradient.Parent = Title

    -- Kapatma Butonu (X)
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Name = "CloseBtn"
    CloseBtn.Parent = Header
    CloseBtn.Position = UDim2.new(1, -42, 0.5, -13)
    CloseBtn.Size = UDim2.new(0, 26, 0, 26)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Font = Enum.Font.ArialBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(190, 170, 220)
    CloseBtn.TextSize = 15
    CloseBtn.AutoButtonColor = false

    CloseBtn.MouseEnter:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 70, 90)}):Play()
    end)
    CloseBtn.MouseLeave:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(190, 170, 220)}):Play()
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        local closeTween = TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        TweenService:Create(Shadow, TweenInfo.new(0.15), {ImageTransparency = 1}):Play()
        closeTween:Play()
        closeTween.Completed:Wait()
        ScreenGui:Destroy()
    end)

    -- ==========================================
    -- AI BUTONU (SAĞ ÜST)
    -- ==========================================
    local AITriggerBtn = Instance.new("TextButton")
    AITriggerBtn.Name = "AITrigger"
    AITriggerBtn.Parent = Header
    AITriggerBtn.Position = UDim2.new(1, -75, 0.5, -13) -- X butonunun solu
    AITriggerBtn.Size = UDim2.new(0, 30, 0, 26)
    AITriggerBtn.BackgroundTransparency = 1
    AITriggerBtn.Font = Enum.Font.GothamBold
    AITriggerBtn.Text = ""
    AITriggerBtn.TextColor3 = Colors.AIStroke
    AITriggerBtn.TextSize = 16
    AITriggerBtn.AutoButtonColor = false
    
    -- Tooltip / Hover Efekti
    AITriggerBtn.MouseEnter:Connect(function()
        TweenService:Create(AITriggerBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(100, 255, 255), BackgroundTransparency = 0.8}):Play()
    end)
    AITriggerBtn.MouseLeave:Connect(function()
        TweenService:Create(AITriggerBtn, TweenInfo.new(0.2), {TextColor3 = Colors.AIStroke, BackgroundTransparency = 1}):Play()
    end)

    -- ==========================================
    -- AI PENCERESİ (Oluşturma Fonksiyonu)
    -- ==========================================
    local AIWindow = nil
    local IsAIOpen = false
    
    local function CreateAIWindow()
        if AIWindow then return end -- Zaten varsa açma
        
        AIWindow = Instance.new("Frame")
        AIWindow.Name = "AIWindow"
        AIWindow.Parent = ScreenGui
        AIWindow.Size = UDim2.new(0, 320, 0, 400)
        AIWindow.BackgroundColor3 = Colors.AIBg
        AIWindow.BackgroundTransparency = 0.2
        AIWindow.BorderSizePixel = 0
        AIWindow.ZIndex = 20 -- Ana menünün üstünde
        
        local AICorner = Instance.new("UICorner")
        AICorner.CornerRadius = UDim.new(0, 16)
        AICorner.Parent = AIWindow
        
        local AIStroke = Instance.new("UIStroke")
        AIStroke.Parent = AIWindow
        AIStroke.Color = Colors.AIStroke
        AIStroke.Thickness = 1.5
        AIStroke.Transparency = 0.3
        
        -- AI Header
        local AIHeader = Instance.new("Frame")
        AIHeader.Name = "Header"
        AIHeader.Parent = AIWindow
        AIHeader.Size = UDim2.new(1, 0, 0, 40)
        AIHeader.BackgroundTransparency = 1
        
        local AITitle = Instance.new("TextLabel")
        AITitle.Name = "Title"
        AITitle.Parent = AIHeader
        AITitle.Position = UDim2.new(0, 15, 0.5, 0)
        AITitle.Size = UDim2.new(0, 200, 0, 20)
        AITitle.BackgroundTransparency = 1
        AITitle.Font = Enum.Font.GothamBold
        AITitle.Text = "ELITE AI ASSISTANT"
        AITitle.TextColor3 = Colors.AIStroke
        AITitle.TextSize = 14
        AITitle.TextXAlignment = Enum.TextXAlignment.Left
        
        local AIClose = Instance.new("TextButton")
        AIClose.Name = "Close"
        AIClose.Parent = AIHeader
        AIClose.Position = UDim2.new(1, -25, 0.5, 0)
        AIClose.Size = UDim2.new(0, 20, 0, 20)
        AIClose.BackgroundTransparency = 1
        AIClose.Font = Enum.Font.ArialBold
        AIClose.Text = "X"
        AIClose.TextColor3 = Color3.fromRGB(200, 200, 200)
        AIClose.TextSize = 14
        AIClose.MouseButton1Click:Connect(function()
            ToggleAI(false)
        end)
        
        -- Chat Area (Scrolling)
        local ChatFrame = Instance.new("ScrollingFrame")
        ChatFrame.Name = "Chat"
        ChatFrame.Parent = AIWindow
        ChatFrame.Position = UDim2.new(0, 10, 0, 50)
        ChatFrame.Size = UDim2.new(1, -20, 1, -110)
        ChatFrame.BackgroundTransparency = 1
        ChatFrame.ScrollBarThickness = 4
        ChatFrame.ScrollBarImageColor3 = Colors.AIStroke
        ChatFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        
        local ChatLayout = Instance.new("UIListLayout")
        ChatLayout.Parent = ChatFrame
        ChatLayout.Padding = UDim.new(0, 8)
        ChatLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ChatLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        
        ChatFrame:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
            ChatFrame.CanvasSize = UDim2.new(0, 0, 0, ChatLayout.AbsoluteContentSize.Y + 16)
            ChatFrame.CanvasPosition = Vector2.new(0, ChatLayout.AbsoluteContentSize.Y)
        end)
        
        -- Input Area
        local InputFrame = Instance.new("Frame")
        InputFrame.Name = "Input"
        InputFrame.Parent = AIWindow
        InputFrame.Position = UDim2.new(0, 10, 1, -50)
        InputFrame.Size = UDim2.new(1, -20, 0, 40)
        InputFrame.BackgroundColor3 = Color3.fromRGB(30, 25, 45)
        InputFrame.BackgroundTransparency = 0.3
        
        local InputCorner = Instance.new("UICorner")
        InputCorner.CornerRadius = UDim.new(0, 10)
        InputCorner.Parent = InputFrame
        
        local TextBox = Instance.new("TextBox")
        TextBox.Parent = InputFrame
        TextBox.Size = UDim2.new(1, -50, 1, 0)
        TextBox.Position = UDim2.new(0, 10, 0, 0)
        TextBox.BackgroundTransparency = 1
        TextBox.Font = Enum.Font.Gotham
        TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        TextBox.TextSize = 13
        TextBox.PlaceholderText = "Sorunuzu yazın..."
        TextBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
        TextBox.TextXAlignment = Enum.TextXAlignment.Left
        
        local SendBtn = Instance.new("TextButton")
        SendBtn.Parent = InputFrame
        SendBtn.Position = UDim2.new(1, -35, 0, 5)
        SendBtn.Size = UDim2.new(0, 30, 0, 30)
        SendBtn.BackgroundTransparency = 1
        SendBtn.Font = Enum.Font.ArialBold
        SendBtn.Text = "➤"
        SendBtn.TextColor3 = Colors.AIStroke
        SendBtn.TextSize = 16
        
        -- Gönderme Mantığı
        local function AddMessage(text, isUser)
            local MsgFrame = Instance.new("Frame")
            MsgFrame.Size = UDim2.new(1, -10, 0, 0) -- Yükseklik metne göre ayarlanacak
            MsgFrame.BackgroundTransparency = 1
            MsgFrame.Parent = ChatFrame
            
            local MsgText = Instance.new("TextLabel")
            MsgText.Parent = MsgFrame
            MsgText.Size = UDim2.new(1, 0, 0, 0)
            MsgText.BackgroundTransparency = 1
            MsgText.Font = Enum.Font.Gotham
            MsgText.TextSize = 13
            MsgText.TextColor3 = isUser and Color3.fromRGB(200, 200, 255) or Color3.fromRGB(100, 255, 200)
            MsgText.Text = text
            MsgText.TextWrapped = true
            MsgText.TextXAlignment = isUser and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
            MsgText.Position = UDim2.new(isUser and 0.2 or 0, 0, 0, 0)
            MsgText.Size = UDim2.new(isUser and 0.8 or 0.8, 0, 0, 0)
            
            -- Otomatik yükseklik ayarı (basitçe)
            MsgText:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                MsgFrame.Size = UDim2.new(1, -10, 0, MsgText.AbsoluteSize.Y + 10)
            end)
            
            -- İlk yükleme için tetikle
            task.wait()
            MsgFrame.Size = UDim2.new(1, -10, 0, MsgText.AbsoluteSize.Y + 10)
        end
        
        local function SendRequest()
            local msg = TextBox.Text
            if msg == "" then return end
            
            AddMessage(msg, true)
            TextBox.Text = ""
            
            -- Yükleniyor mesajı
            local loadingMsg = Instance.new("TextLabel")
            loadingMsg.Name = "Loading"
            loadingMsg.Parent = ChatFrame
            loadingMsg.Size = UDim2.new(1, -10, 0, 20)
            loadingMsg.BackgroundTransparency = 1
            loadingMsg.Font = Enum.Font.GothamItalic
            loadingMsg.TextSize = 12
            loadingMsg.TextColor3 = Color3.fromRGB(150, 150, 150)
            loadingMsg.Text = "Düşünülüyor..."
            loadingMsg.TextXAlignment = Enum.TextXAlignment.Left
            
            -- API İsteği
            local success, result = pcall(function()
                local response = HttpService:RequestAsync({
                    Url = "https://8328-iaegwjno6hih212t36m6p-3442aba1.us3.manus.computer/api/chat",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({ message = msg }),
                })
                if response.StatusCode == 200 then
                    local data = HttpService:JSONDecode(response.Body)
                    return data.reply or "Cevap alınamadı."
                else
                    return "Hata: " .. tostring(response.StatusCode)
                end
            end)
            
            loadingMsg:Destroy()
            
            if success then
                AddMessage(result, false)
            else
                AddMessage("Bağlantı hatası: " .. tostring(result), false)
            end
        end
        
        SendBtn.MouseButton1Click:Connect(SendRequest)
        TextBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then SendRequest() end
        end)
        
        -- Animasyonla Aç
        AIWindow.Size = UDim2.new(0, 0, 0, 0)
        AIWindow.Position = UDim2.new(0, Main.Position.X.Offset + 250, 0, Main.Position.Y.Offset) -- Başlangıç pozisyonu (geçici)
        AIWindow.Visible = true
        
        TweenService:Create(AIWindow, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 320, 0, 400)
        }):Play()
        
        IsAIOpen = true
    end
    
    local function ToggleAI(state)
        if state == nil then state = not IsAIOpen end
        
        if state and not IsAIOpen then
            CreateAIWindow()
            -- Pozisyon güncelleme döngüsü başlat (Ana menü hareket ederse AI da gelsin)
            task.spawn(function()
                while IsAIOpen and AIWindow and Main do
                    local mainPos = Main.Position
                    local viewport = workspace.CurrentCamera.ViewportSize
                    
                    -- Hedef X: Ana menünün sağı
                    local targetX = mainPos.X.Offset + 250 -- 480/2 + boşluk
                    
                    -- Ekran Sınırı Kontrolü
                    if targetX + 320 > viewport.X then
                        -- Sağa taşıyorsa ekran dışına çıkıyor, o zaman sola al
                        targetX = mainPos.X.Offset - 330
                    end
                    
                    -- Y pozisyonu aynı kalsın
                    local targetY = mainPos.Y.Offset
                    
                    -- Yumuşak geçiş (Lerp)
                    local currentPos = AIWindow.Position
                    local newPos = UDim2.new(0, currentPos.X.Offset + (targetX - currentPos.X.Offset) * 0.1, 0, currentPos.Y.Offset + (targetY - currentPos.Y.Offset) * 0.1)
                    AIWindow.Position = newPos
                    
                    task.wait(0.03)
                end
            end)
        elseif not state and IsAIOpen then
            if AIWindow then
                TweenService:Create(AIWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0)
                }):Play()
                task.wait(0.25)
                AIWindow:Destroy()
                AIWindow = nil
            end
            IsAIOpen = false
        end
    end
    
    -- AI Butonuna Tıklama
    AITriggerBtn.MouseButton1Click:Connect(function()
        ToggleAI()
    end)

    -- ==========================================
    -- SÜRÜKLEME & İÇERİK (ANA MENÜ)
    -- ==========================================
    
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local targetPos = Main.Position

    Header.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            dragInput = input
            dragStart = input.Position
            startPos = Main.Position
            targetPos = Main.Position
            -- AI penceresi açıksa onu da takip ettirmek için döngü zaten var
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging or (Main.Position ~= targetPos) then
            Main.Position = Main.Position:Lerp(targetPos, 0.25)
        end
    end)

    -- Container (Butonlar buraya gelecek)
    local Container = Instance.new("ScrollingFrame")
    Container.Name = "Container"
    Container.Parent = Content
    Container.BackgroundTransparency = 1
    Container.Position = UDim2.new(0, 22, 0, 56)
    Container.Size = UDim2.new(1, -44, 0, 185)
    Container.ScrollBarThickness = 2
    Container.ScrollBarImageColor3 = Colors.StrokeEnd
    Container.BorderSizePixel = 0

    local UIGrid = Instance.new("UIGridLayout")
    UIGrid.Parent = Container
    UIGrid.CellSize = UDim2.new(0.48, 0, 0, 68)
    UIGrid.CellPadding = UDim2.new(0.04, 0, 0, 12)
    UIGrid.HorizontalAlignment = Enum.HorizontalAlignment.Center

    UIGrid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Container.CanvasSize = UDim2.new(0, 0, 0, UIGrid.AbsoluteContentSize.Y + 10)
    end)

    -- Footer
    local UserFooter = Instance.new("Frame")
    UserFooter.Name = "UserFooter"
    UserFooter.Parent = Content
    UserFooter.Position = UDim2.new(0, 22, 1, -40)
    UserFooter.Size = UDim2.new(1, -44, 0, 32)
    UserFooter.BackgroundTransparency = 1

    local UserAvatar = Instance.new("ImageLabel")
    UserAvatar.Name = "UserAvatar"
    UserAvatar.Parent = UserFooter
    UserAvatar.Position = UDim2.new(0, 0, 0.5, -13)
    UserAvatar.Size = UDim2.new(0, 26, 0, 26)
    UserAvatar.BackgroundTransparency = 1
    UserAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = UserAvatar

    local UserName = Instance.new("TextLabel")
    UserName.Name = "UserName"
    UserName.Parent = UserFooter
    UserName.Position = UDim2.new(0, 34, 0, 0)
    UserName.Size = UDim2.new(0, 220, 1, 0)
    UserName.BackgroundTransparency = 1
    UserName.Font = Enum.Font.GothamMedium
    UserName.Text = LocalPlayer.Name
    UserName.TextColor3 = Color3.fromRGB(210, 195, 235)
    UserName.TextSize = 13
    UserName.TextXAlignment = Enum.TextXAlignment.Left

    local StatusText = Instance.new("TextLabel")
    StatusText.Name = "StatusText"
    StatusText.Parent = UserFooter
    StatusText.Position = UDim2.new(1, -100, 0, 0)
    StatusText.Size = UDim2.new(0, 100, 1, 0)
    StatusText.BackgroundTransparency = 1
    StatusText.Font = Enum.Font.GothamBold
    StatusText.Text = "● ONLINE"
    StatusText.TextColor3 = Color3.fromRGB(100, 210, 150)
    StatusText.TextSize = 11
    StatusText.TextXAlignment = Enum.TextXAlignment.Right

    -- Açılış Animasyonu
    Main.Size = UDim2.new(0, 0, 0, 0)
    Shadow.ImageTransparency = 1
    TweenService:Create(Main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(0, 480, 0, 300) }):Play()
    TweenService:Create(Shadow, TweenInfo.new(0.35), { ImageTransparency = 0.4 }):Play()

    -- Return Elements
    local WindowElements = {}
    function WindowElements:CreateButton(ButtonSettings)
        ButtonSettings = ButtonSettings or {}
        local BtnName = ButtonSettings.Name or "Button"
        local Callback = ButtonSettings.Callback or function() end

        local btn = Instance.new("TextButton")
        btn.Name = BtnName
        btn.Parent = Container
        btn.BackgroundColor3 = Colors.BtnBg
        btn.BackgroundTransparency = 0.3
        btn.AutoButtonColor = false
        btn.Font = Enum.Font.GothamMedium
        btn.Text = BtnName
        btn.TextColor3 = Color3.fromRGB(220, 210, 235)
        btn.TextSize = 14

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 14)
        btnCorner.Parent = btn

        local btnStroke = Instance.new("UIStroke")
        btnStroke.Parent = btn
        btnStroke.Color = Color3.fromRGB(65, 38, 98)
        btnStroke.Thickness = 1.2
        btnStroke.Transparency = 0.5

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Colors.BtnHover, BackgroundTransparency = 0.1, TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), { Color = Colors.StrokeStart, Transparency = 0 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Colors.BtnBg, BackgroundTransparency = 0.3, TextColor3 = Color3.fromRGB(220, 210, 235) }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(65, 38, 98), Transparency = 0.5 }):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.06), {Size = UDim2.new(0.45, 0, 0, 63)}):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0.48, 0, 0, 68)}):Play()
            pcall(Callback)
        end)
        return btn
    end

    return WindowElements
end

return EliteHub
