        local boxCorner = Instance.new("UICorner")
        boxCorner.CornerRadius = UDim.new(0, 6)
        boxCorner.Parent = textBox

        local boxStroke = Instance.new("UIStroke")
        boxStroke.Parent = textBox
        boxStroke.Color = Color3.fromRGB(130, 60, 200)
        boxStroke.Transparency = 1

        textBox.Focused:Connect(function()
            TweenService:Create(textBox, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(32, 22, 50),
                Size = UDim2.new(1, -20, 0, 26),
                Position = UDim2.new(0, 10, 0, 21)
            }):Play()
            TweenService:Create(boxStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
        end)

        textBox.FocusLost:Connect(function(enterPressed)
            TweenService:Create(textBox, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(22, 15, 35),
                Size = UDim2.new(1, -28, 0, 24),
                Position = UDim2.new(0, 14, 0, 22)
            }):Play()
            TweenService:Create(boxStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
            pcall(Settings.Callback or function() end, textBox.Text)
        end)

        return frame
    end

    function WindowElements:CreateLabel(TextContent)
        local labelFrame = Instance.new("Frame")
        labelFrame.Parent = Container
        labelFrame.Size = UDim2.new(1, 0, 0, 28)
        labelFrame.BackgroundTransparency = 1
        labelFrame.ZIndex = 5

        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = labelFrame
        textLabel.Size = UDim2.new(1, -14, 1, 0)
        textLabel.Position = UDim2.new(0, 7, 0, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Text = TextContent or ""
        textLabel.TextColor3 = Color3.fromRGB(160, 130, 200)
        textLabel.TextSize = 12
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        textLabel.ZIndex = 5
        return labelFrame
    end

    function WindowElements:CreateSubWindow(SubSettings)
        SubSettings = SubSettings or {}
        local SubName = SubSettings.Name or "SUB WINDOW"

        local SubMain = Instance.new("Frame")
        SubMain.Name = "SubWindow"
        SubMain.Parent = ScreenGui
        SubMain.AnchorPoint = Vector2.new(0.5, 0.5)
        SubMain.Position = UDim2.new(0.5, 140, 0.5, 0)
        SubMain.Size = UDim2.new(0, 0, 0, 0)
        SubMain.BackgroundColor3 = Color3.fromRGB(8, 6, 12)
        SubMain.BackgroundTransparency = 1
        SubMain.Visible = false
        SubMain.ZIndex = 10

        local SubCorner = Instance.new("UICorner")
        SubCorner.CornerRadius = UDim.new(0, 16)
        SubCorner.Parent = SubMain

        local SubStroke = Instance.new("UIStroke")
        SubStroke.Parent = SubMain
        SubStroke.Color = Color3.fromRGB(120, 50, 190)
        SubStroke.Thickness = 1.4

        local SubHeader = Instance.new("Frame")
        SubHeader.Name = "SubHeader"
        SubHeader.Parent = SubMain
        SubHeader.Size = UDim2.new(1, 0, 0, 44)
        SubHeader.BackgroundTransparency = 1
        SubHeader.ZIndex = 11

        local SubTitle = Instance.new("TextLabel")
        SubTitle.Parent = SubHeader
        SubTitle.Position = UDim2.new(0, 16, 0.5, -11)
        SubTitle.Size = UDim2.new(0, 200, 0, 22)
        SubTitle.BackgroundTransparency = 1
        SubTitle.Font = Enum.Font.GothamBlack
        SubTitle.Text = string.upper(SubName)
        SubTitle.TextColor3 = Color3.fromRGB(235, 225, 250)
        SubTitle.TextSize = 15
        SubTitle.TextXAlignment = Enum.TextXAlignment.Left

        local SubClose = Instance.new("TextButton")
        SubClose.Parent = SubHeader
        SubClose.Position = UDim2.new(1, -36, 0.5, -11)
        SubClose.Size = UDim2.new(0, 22, 0, 22)
        SubClose.BackgroundTransparency = 1
        SubClose.Font = Enum.Font.ArialBold
        SubClose.Text = "X"
        SubClose.TextColor3 = Color3.fromRGB(170, 150, 200)
        SubClose.TextSize = 13
        SubClose.ZIndex = 12

        local SubAPI = {}

        function SubAPI:Open()
            SubMain.Visible = true
            TweenService:Create(SubMain, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 360, 0, 260),
                BackgroundTransparency = 0.15
            }):Play()
        end

        function SubAPI:Close()
            TweenService:Create(SubMain, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }):Play()
            task.wait(0.2)
            SubMain.Visible = false
        end

        function SubAPI:Toggle()
            if SubMain.Visible then
                SubAPI:Close()
            else
                SubAPI:Open()
            end
        end

        SubClose.MouseButton1Click:Connect(function()
            SubAPI:Close()
        end)

        local SubContainer = Instance.new("ScrollingFrame")
        SubContainer.Parent = SubMain
        SubContainer.BackgroundTransparency = 1
        SubContainer.Position = UDim2.new(0, 12, 0, 46)
        SubContainer.Size = UDim2.new(1, -24, 1, -56)
        SubContainer.ScrollBarThickness = 2
        SubContainer.ScrollBarImageColor3 = Color3.fromRGB(120, 60, 180)
        SubContainer.BorderSizePixel = 0
        SubContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y

        local SubList = Instance.new("UIListLayout")
        SubList.Parent = SubContainer
        SubList.SortOrder = Enum.SortOrder.LayoutOrder
        SubList.Padding = UDim.new(0, 6)
        SubList.HorizontalAlignment = Enum.HorizontalAlignment.Center

        return SubAPI
    end

    return WindowElements
end

return SynapseHub
