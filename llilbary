-- ========================================================
-- SYNAPSE HUB - Fixed Multi-Mode UI Library
-- ========================================================

local SynapseHub = {}
SynapseHub.__index = SynapseHub

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

function SynapseHub:CreateWindow(Settings)
    Settings = Settings or {}
    local WindowName = Settings.Name or "SYNAPSE HUB"
    
    if CoreGui:FindFirstChild("SynapseHubLibrary") then
        CoreGui.SynapseHubLibrary:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SynapseHubLibrary"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false

    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Parent = ScreenGui
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.Size = UDim2.new(0, 480, 0, 320)
    Main.BackgroundColor3 = Color3.fromRGB(8, 6, 12)
    Main.BackgroundTransparency = 0.15
    Main.ClipsDescendants = false

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 20)
    MainCorner.Parent = Main

    local ModalBlocker = Instance.new("TextButton")
    ModalBlocker.Name = "ModalBlocker"
    ModalBlocker.Parent = Main
    ModalBlocker.Size = UDim2.new(1, 0, 1, 0)
    ModalBlocker.BackgroundTransparency = 1
    ModalBlocker.Text = ""
    ModalBlocker.Modal = true

    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Parent = Main
    Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    Shadow.Position = UDim2.new(0.5, 0, 0.5, 4)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://6014261993"
    Shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    Shadow.ImageTransparency = 0.5
    Shadow.ZIndex = 0

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Parent = Main
    MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    MainStroke.Thickness = 1.4

    local StrokeGradient = Instance.new("UIGradient")
    StrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 50, 190)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(20, 10, 30)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 30, 150))
    })
    StrokeGradient.Rotation = 45
    StrokeGradient.Parent = MainStroke

    local Content = Instance.new("Frame")
    Content.Name = "Content"
    Content.Parent = Main
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.BackgroundTransparency = 1
    Content.ClipsDescendants = true
    Content.ZIndex = 2

    local ContentCorner = Instance.new("UICorner")
    ContentCorner.CornerRadius = UDim.new(0, 20)
    ContentCorner.Parent = Content

    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Parent = Content
    Header.Size = UDim2.new(1, 0, 0, 50)
    Header.BackgroundTransparency = 1
    Header.ZIndex = 3

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Parent = Header
    Title.Position = UDim2.new(0, 22, 0.5, -13)
    Title.Size = UDim2.new(0, 250, 0, 26)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBlack
    Title.Text = string.upper(WindowName)
    Title.TextColor3 = Color3.fromRGB(235, 225, 250)
    Title.TextSize = 18
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local TitleGradient = Instance.new("UIGradient")
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 100, 210))
    })
    TitleGradient.Parent = Title

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Name = "CloseBtn"
    CloseBtn.Parent = Header
    CloseBtn.Position = UDim2.new(1, -42, 0.5, -13)
    CloseBtn.Size = UDim2.new(0, 26, 0, 26)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Font = Enum.Font.ArialBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(170, 150, 200)
    CloseBtn.TextSize = 15
    CloseBtn.AutoButtonColor = false
    CloseBtn.ZIndex = 4

    CloseBtn.MouseEnter:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 70, 90)}):Play()
    end)
    CloseBtn.MouseLeave:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(170, 150, 200)}):Play()
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        TweenService:Create(Shadow, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
        task.wait(0.3)
        ScreenGui:Destroy()
    end)

    -- SÜRÜKLEME FİZİĞİ
    local dragging = false
    local activeTouch = nil
    local dragStart = nil
    local startPos = nil
    local targetPos = Main.Position

    Header.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeTouch then
            dragging = true
            activeTouch = input
            dragStart = input.Position
            startPos = Main.Position
            targetPos = Main.Position
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == activeTouch then
            dragging = false
            activeTouch = nil
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == activeTouch then
            local delta = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    RunService.RenderStepped:Connect(function()
        local viewportSize = workspace.CurrentCamera.ViewportSize
        local halfW = Main.AbsoluteSize.X / 2
        local halfH = Main.AbsoluteSize.Y / 2
        
        local clampedX = math.clamp(targetPos.X.Offset, halfW, viewportSize.X - halfW)
        local clampedY = math.clamp(targetPos.Y.Offset, halfH, viewportSize.Y - halfH)
        
        targetPos = UDim2.new(0, clampedX, 0, clampedY)

        if dragging then
            Main.Position = Main.Position:Lerp(targetPos, 0.4)
        else
            Main.Position = Main.Position:Lerp(targetPos, 0.15)
        end
    end)

    local Container = Instance.new("ScrollingFrame")
    Container.Name = "Container"
    Container.Parent = Content
    Container.BackgroundTransparency = 1
    Container.Position = UDim2.new(0, 16, 0, 55)
    Container.Size = UDim2.new(1, -32, 0, 215)
    Container.ScrollBarThickness = 3
    Container.ScrollBarImageColor3 = Color3.fromRGB(120, 60, 180)
    Container.BorderSizePixel = 0
    Container.CanvasSize = UDim2.new(0, 0, 0, 0)
    Container.AutomaticCanvasSize = Enum.AutomaticSize.Y

    local UIList = Instance.new("UIListLayout")
    UIList.Parent = Container
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 10)
    UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local UserFooter = Instance.new("Frame")
    UserFooter.Name = "UserFooter"
    UserFooter.Parent = Content
    UserFooter.Position = UDim2.new(0, 22, 1, -38)
    UserFooter.Size = UDim2.new(1, -44, 0, 30)
    UserFooter.BackgroundTransparency = 1

    local UserAvatar = Instance.new("ImageLabel")
    UserAvatar.Name = "UserAvatar"
    UserAvatar.Parent = UserFooter
    UserAvatar.Position = UDim2.new(0, 0, 0.5, -12)
    UserAvatar.Size = UDim2.new(0, 24, 0, 24)
    UserAvatar.BackgroundTransparency = 1
    UserAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"

    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = UserAvatar

    local UserName = Instance.new("TextLabel")
    UserName.Name = "UserName"
    UserName.Parent = UserFooter
    UserName.Position = UDim2.new(0, 32, 0, 0)
    UserName.Size = UDim2.new(0, 220, 1, 0)
    UserName.BackgroundTransparency = 1
    UserName.Font = Enum.Font.GothamMedium
    UserName.Text = LocalPlayer.Name
    UserName.TextColor3 = Color3.fromRGB(190, 175, 215)
    UserName.TextSize = 12
    UserName.TextXAlignment = Enum.TextXAlignment.Left

    local StatusText = Instance.new("TextLabel")
    StatusText.Name = "StatusText"
    StatusText.Parent = UserFooter
    StatusText.Position = UDim2.new(1, -90, 0, 0)
    StatusText.Size = UDim2.new(0, 90, 1, 0)
    StatusText.BackgroundTransparency = 1
    StatusText.Font = Enum.Font.GothamBold
    StatusText.Text = "● ONLINE"
    StatusText.TextColor3 = Color3.fromRGB(80, 190, 130)
    StatusText.TextSize = 10
    StatusText.TextXAlignment = Enum.TextXAlignment.Right

    local WindowElements = {}

    local function applyButtonStyles(btn)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Parent = btn
        stroke.Color = Color3.fromRGB(60, 30, 95)
        stroke.Thickness = 1.4
        stroke.Transparency = 0.3

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(36, 20, 60), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(150, 70, 220), Transparency = 0}):Play()
        end)

        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(16, 11, 26), TextColor3 = Color3.fromRGB(220, 210, 240)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(60, 30, 95), Transparency = 0.3}):Play()
        end)
    end

    -- 1. TOMBUL MENÜ (En fazla 3 buton, boşluksuz ve büyük)
    function WindowElements:CreateChunkyGroup(ButtonsData)
        ButtonsData = ButtonsData or {}
        local count = #ButtonsData
        if count == 0 then return end
        if count > 3 then count = 3 end

        local rowFrame = Instance.new("Frame")
        rowFrame.Parent = Container
        rowFrame.BackgroundTransparency = 1

        if count == 1 then
            rowFrame.Size = UDim2.new(1, 0, 0, 95)
            local btn = Instance.new("TextButton")
            btn.Parent = rowFrame
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.AutoButtonColor = false
            btn.Font = Enum.Font.GothamBold
            btn.Text = ButtonsData[1].Name or "Buton"
            btn.TextColor3 = Color3.fromRGB(220, 210, 240)
            btn.TextSize = 16
            btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
            btn.BackgroundTransparency = 0.15

            applyButtonStyles(btn)
            btn.MouseButton1Click:Connect(function()
                if ButtonsData[1].Callback then
                    pcall(ButtonsData[1].Callback)
                end
            end)

        elseif count == 2 then
            rowFrame.Size = UDim2.new(1, 0, 0, 56)
            for i = 1, 2 do
                local data = ButtonsData[i]
                local btn = Instance.new("TextButton")
                btn.Parent = rowFrame
                btn.Size = UDim2.new(0.48, 0, 1, 0)
                btn.Position = UDim2.new((i - 1) * 0.52, 0, 0, 0)
                btn.AutoButtonColor = false
                btn.Font = Enum.Font.GothamBold
                btn.Text = data.Name or "Buton"
                btn.TextColor3 = Color3.fromRGB(220, 210, 240)
                btn.TextSize = 14
                btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
                btn.BackgroundTransparency = 0.15

                applyButtonStyles(btn)
                btn.MouseButton1Click:Connect(function()
                    if data.Callback then
                        pcall(data.Callback)
                    end
                end)
            end

        elseif count == 3 then
            rowFrame.Size = UDim2.new(1, 0, 0, 122)

            for i = 1, 2 do
                local data = ButtonsData[i]
                local btn = Instance.new("TextButton")
                btn.Parent = rowFrame
                btn.Size = UDim2.new(0.48, 0, 0, 56)
                btn.Position = UDim2.new((i - 1) * 0.52, 0, 0, 0)
                btn.AutoButtonColor = false
                btn.Font = Enum.Font.GothamBold
                btn.Text = data.Name or "Buton"
                btn.TextColor3 = Color3.fromRGB(220, 210, 240)
                btn.TextSize = 14
                btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
                btn.BackgroundTransparency = 0.15

                applyButtonStyles(btn)
                btn.MouseButton1Click:Connect(function()
                    if data.Callback then
                        pcall(data.Callback)
                    end
                end)
            end

            local data3 = ButtonsData[3]
            local btn3 = Instance.new("TextButton")
            btn3.Parent = rowFrame
            btn3.Size = UDim2.new(1, 0, 0, 56)
            btn3.Position = UDim2.new(0, 0, 0, 66)
            btn3.AutoButtonColor = false
            btn3.Font = Enum.Font.GothamBold
            btn3.Text = data3.Name or "Buton"
            btn3.TextColor3 = Color3.fromRGB(220, 210, 240)
            btn3.TextSize = 14
            btn3.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
            btn3.BackgroundTransparency = 0.15

            applyButtonStyles(btn3)
            btn3.MouseButton1Click:Connect(function()
                if data3.Callback then
                    pcall(data3.Callback)
                end
            end)
        end

        return rowFrame
    end

    -- 2. TAM BOYUT MENÜ (Sonsuz Butonlu)
    function WindowElements:CreateFullMenu(ButtonsData)
        ButtonsData = ButtonsData or {}
        local groupFrame = Instance.new("Frame")
        groupFrame.Parent = Container
        groupFrame.Size = UDim2.new(1, 0, 0, #ButtonsData * 62)
        groupFrame.BackgroundTransparency = 1

        local list = Instance.new("UIListLayout")
        list.Parent = groupFrame
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Padding = UDim.new(0, 6)

        for _, data in ipairs(ButtonsData) do
            local btn = Instance.new("TextButton")
            btn.Parent = groupFrame
            btn.Size = UDim2.new(1, 0, 0, 56)
            btn.AutoButtonColor = false
            btn.Font = Enum.Font.GothamBold
            btn.Text = data.Name or "Buton"
            btn.TextColor3 = Color3.fromRGB(220, 210, 240)
            btn.TextSize = 14
            btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
            btn.BackgroundTransparency = 0.15

            applyButtonStyles(btn)
            btn.MouseButton1Click:Connect(function()
                if data.Callback then
                    pcall(data.Callback)
                end
            end)
        end

        return groupFrame
    end

    -- 3. DİKEY MENÜ (Sonsuz Butonlu, İkili Kolon)
    function WindowElements:CreateVerticalMenu(ButtonsData)
        ButtonsData = ButtonsData or {}
        local groupFrame = Instance.new("Frame")
        groupFrame.Parent = Container
        groupFrame.Size = UDim2.new(1, 0, 0, math.ceil(#ButtonsData / 2) * 56 + math.floor(#ButtonsData / 2) * 6)
        groupFrame.BackgroundTransparency = 1

        for i, data in ipairs(ButtonsData) do
            local btn = Instance.new("TextButton")
            btn.Parent = groupFrame
            local isEven = (i % 2 == 0)
            btn.Size = UDim2.new(0.48, 0, 0, 50)
            btn.Position = UDim2.new(isEven and 0.52 or 0, 0, 0, math.floor((i - 1) / 2) * 56)
            btn.AutoButtonColor = false
            btn.Font = Enum.Font.GothamBold
            btn.Text = data.Name or "Buton"
            btn.TextColor3 = Color3.fromRGB(220, 210, 240)
            btn.TextSize = 13
            btn.BackgroundColor3 = Color3.fromRGB(16, 11, 26)
            btn.BackgroundTransparency = 0.15

            applyButtonStyles(btn)
            btn.MouseButton1Click:Connect(function()
                if data.Callback then
                    pcall(data.Callback)
                end
            end)
        end

        return groupFrame
    end

    function WindowElements:CreateToggle(Settings)
        Settings = Settings or {}
        local toggled = Settings.Default or false
        local frame = Instance.new("TextButton")
        frame.Parent = Container
        frame.Size = UDim2.new(1, 0, 0, 48)
        frame.BackgroundColor3 = Color3.fromRGB(14, 10, 22)
        frame.BackgroundTransparency = 0.2
        frame.AutoButtonColor = false
        frame.Text = ""

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Parent = frame
        stroke.Color = Color3.fromRGB(45, 25, 70)
        stroke.Thickness = 1.2
        stroke.Transparency = 0.4

        local label = Instance.new("TextLabel")
        label.Parent = frame
        label.Position = UDim2.new(0, 14, 0, 0)
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamMedium
        label.Text = Settings.Name or ""
        label.TextColor3 = Color3.fromRGB(200, 190, 220)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left

        local switch = Instance.new("Frame")
        switch.Parent = frame
        switch.AnchorPoint = Vector2.new(1, 0.5)
        switch.Position = UDim2.new(1, -14, 0.5, 0)
        switch.Size = UDim2.new(0, 40, 0, 20)
        switch.BackgroundColor3 = toggled and Color3.fromRGB(130, 60, 200) or Color3.fromRGB(25, 18, 38)

        local switchCorner = Instance.new("UICorner")
        switchCorner.CornerRadius = UDim.new(1, 0)
        switchCorner.Parent = switch

        local circle = Instance.new("Frame")
        circle.Parent = switch
        circle.AnchorPoint = Vector2.new(0, 0.5)
        circle.Position = toggled and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        circle.Size = UDim2.new(0, 16, 0, 16)
        circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

        local circleCorner = Instance.new("UICorner")
        circleCorner.CornerRadius = UDim.new(1, 0)
        circleCorner.Parent = circle

        frame.MouseButton1Up:Connect(function()
            toggled = not toggled
            TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = toggled and Color3.fromRGB(130, 60, 200) or Color3.fromRGB(25, 18, 38)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {Position = toggled and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)}):Play()
            if Settings.Callback then
                pcall(Settings.Callback, toggled)
            end
        end)

        return frame
    end

    function WindowElements:CreateLabel(TextContent)
        local labelFrame = Instance.new("Frame")
        labelFrame.Parent = Container
        labelFrame.Size = UDim2.new(1, 0, 0, 28)
        labelFrame.BackgroundTransparency = 1

        local textLabel = Instance.new("TextLabel")
        textLabel.Parent = labelFrame
        textLabel.Size = UDim2.new(1, -14, 1, 0)
        textLabel.Position = UDim2.new(0, 7, 0, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Text = TextContent or ""
        textLabel.TextColor3 = Color3.fromRGB(160, 130, 200)
        textLabel.TextSize = 12
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        return labelFrame
    end

    return WindowElements
end

return SynapseHub
