        local clampedY = math.clamp(targetPos.Y.Offset, halfH, viewportSize.Y - halfH)
        
        targetPos = UDim2.new(0, clampedX, 0, clampedY)

        if dragging then
            Main.Position = Main.Position:Lerp(targetPos, 0.4)
        else
            Main.Position = Main.Position:Lerp(targetPos, 0.15)
        end
    end)

