    local dragStart = nil
    local startPos = nil
    local targetPos = Main.Position

    Header.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeTouch then
            dragging = true
            activeTouch = input
            dragStart = input.Position
            startPos = Main.Position
            targetPos = Main.Position
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == activeTouch then
            dragging = false
            activeTouch = nil
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == activeTouch then
            local delta = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    RunService.RenderStepped:Connect(function()
        local viewportSize = workspace.CurrentCamera.ViewportSize
        local halfW = Main.AbsoluteSize.X / 2
        local halfH = Main.AbsoluteSize.Y / 2
        
        local clampedX = math.clamp(targetPos.X.Offset, halfW, viewportSize.X - halfW)
        local clampedY = math.clamp(targetPos.Y.Offset, halfH, viewportSize.Y - halfH)
        
        targetPos = UDim2.new(0, clampedX, 0, clampedY)

        if dragging then
            Main.Position = Main.Position:Lerp(targetPos, 0.4)
        else
            Main.Position = Main.Position:Lerp(targetPos, 0.15)
        end
    end)

